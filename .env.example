# =============================================================================
# GMG Investment Intelligence — Environment Configuration
# GMG AI Solutions
# =============================================================================
# Copy this file to `.env` and fill in the values you have:
#
#   cp .env.example .env
#
# The application RUNS WITHOUT ANY CREDENTIALS. Every credential below is
# optional and unlocks one additional capability. A missing credential causes
# the corresponding data to be labelled "N/A — data unavailable" or
# "DEMO DATA — NOT REAL-TIME", never fabricated and never presented as live.
#
# NEVER commit your .env file. It is git-ignored. Never paste a real key into
# source code, a template, a commit message or an issue.
# =============================================================================


# -----------------------------------------------------------------------------
# CORE APPLICATION
# -----------------------------------------------------------------------------
EGX_ENV=development                 # development | production
EGX_HOST=127.0.0.1
EGX_PORT=8000
EGX_LOG_LEVEL=INFO
EGX_LOG_FORMAT=text                 # "json" in production

# The public base URL, used to build links in emails. Set this in production or
# verification and password-reset links will point at localhost.
EGX_BASE_URL=http://127.0.0.1:8000


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# SQLite by default (zero setup). PostgreSQL is supported by changing this URL:
#   postgresql+psycopg://user:password@localhost:5432/gmg
EGX_DATABASE_URL=sqlite:///./data/gmg.db


# -----------------------------------------------------------------------------
# SECURITY  (REQUIRED IN PRODUCTION)
# -----------------------------------------------------------------------------
# Signs session cookies and derives CSRF tokens. The application REFUSES TO
# START in production without it. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating this value signs every user out. Never reuse it across environments.
EGX_AUTH_SECRET=

# Cookie name and lifetime.
EGX_SESSION_COOKIE=gmg_session
EGX_SESSION_DAYS=14

# Send the session cookie only over HTTPS. MUST be true in production.
EGX_COOKIE_SECURE=false

# Argon2id parameters. Higher is safer and slower. The defaults follow the
# OWASP recommendation; raise memory before raising time.
EGX_ARGON2_TIME_COST=3
EGX_ARGON2_MEMORY_KIB=65536
EGX_ARGON2_PARALLELISM=4

# Brute-force protection: attempts per window, then a lockout.
EGX_LOGIN_MAX_ATTEMPTS=8
EGX_LOGIN_WINDOW_MINUTES=15
EGX_LOGIN_LOCKOUT_MINUTES=20
EGX_RATE_LIMIT_PER_MINUTE=120

# Require a verified email address before sign-in succeeds.
EGX_REQUIRE_EMAIL_VERIFICATION=true

# The first account created becomes an administrator. Setting this address also
# promotes it to administrator when it registers.
EGX_ADMIN_EMAIL=


# -----------------------------------------------------------------------------
# SUBSCRIPTION PLAN
# -----------------------------------------------------------------------------
EGX_PLAN_CODE=gmg-pro
EGX_PLAN_NAME=GMG Investment Intelligence
EGX_PLAN_PRICE_EGP=300
EGX_PLAN_INTERVAL=month
EGX_TRIAL_DAYS=7


# -----------------------------------------------------------------------------
# PAYMENTS
# -----------------------------------------------------------------------------
# "manual"  — no gateway. Checkout records intent only, NO CARD IS CHARGED, and
#             an administrator activates the subscription after confirming an
#             out-of-band transfer. This is the honest default.
# "gateway" — a real Egyptian payment provider. Implement PaymentProvider in
#             backend/billing/payments.py and register it, then set the key
#             below. Without the key, checkout is refused rather than faked.
#
# There is deliberately NO demo gateway: a provider that flipped payments to
# SUCCEEDED on its own would leave a database indistinguishable from a real one.
EGX_PAYMENT_PROVIDER=manual
EGX_PAYMENT_API_KEY=
EGX_PAYMENT_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
# "console" — writes messages to the log (development default)
# "smtp"    — real delivery; requires the SMTP settings below
# "null"    — records the attempt and sends nothing
EGX_EMAIL_PROVIDER=console
EGX_EMAIL_FROM=no-reply@example.com
EGX_EMAIL_FROM_NAME=GMG Investment Intelligence
EGX_SMTP_HOST=
EGX_SMTP_PORT=587
EGX_SMTP_USER=
EGX_SMTP_PASSWORD=
# For a transactional-email API (SendGrid, Postmark, Mailgun) rather than SMTP.
EGX_EMAIL_API_KEY=


# -----------------------------------------------------------------------------
# MARKET DATA
# -----------------------------------------------------------------------------
# Credentials for a LICENSED EGX market-data vendor. With no key, quotes fall
# back to stored end-of-day bars, and to the demo provider only when nothing
# real exists — labelled "DEMO DATA — NOT REAL-TIME" everywhere it appears.
#
# THIS IS THE SWITCH THAT MAKES THE PLATFORM LIVE.
#
# Two settings are required together. A key with no vendor, or a vendor with no
# key, is a misconfiguration and serves nothing — it never falls back to demo
# prices, because a silent downgrade would put fabricated numbers behind a
# "live" label.
#
#   1. Name the vendor.  Built-in presets: eodhd, twelvedata
#      For any other vendor (a local broker, Refinitiv, an exchange feed), write
#      a JSON spec instead of code and set EGX_MARKET_DATA_SPEC_PATH.
#      See docs/GOING_LIVE.md and config/vendor-spec.example.json.
EGX_MARKET_DATA_VENDOR=
EGX_MARKET_DATA_SPEC_PATH=
#
#   2. Supply the key you pay for.
EGX_MARKET_DATA_API_KEY=
#
# What your licence actually grants. 0 = real-time, 15 = standard delayed feed.
# This number is shown to users verbatim, so it must be true.
EGX_QUOTE_DELAY_MINUTES=15
#
# How often the scheduler polls the vendor while the market is open. Keep it
# within your plan's rate limit; the whole universe is fetched per cycle, not
# per visitor. No polling job is registered at all without a live feed.
EGX_QUOTE_REFRESH_SECONDS=60
#
# Per-vendor ticker -> vendor symbol overrides, for the symbols that do not
# follow the default pattern. Vendors disagree about EGX symbology; fix them
# here rather than in code.
EGX_SYMBOL_MAP_PATH=config/symbol_map.json
#
# Verify before trusting a single price:
#   python scripts/verify_market_data.py --tickers COMI,HRHO,SWDY --raw
#
# NOTE: TradingView is not a data source here. It is not scraped, and no claim
# is made that it offers an unrestricted real-time market-data API.

# EGX trading session (Cairo time). Sunday=6, Monday=0 … Thursday=3.
EGX_MARKET_OPEN_TIME=10:00
EGX_MARKET_CLOSE_TIME=14:30
EGX_MARKET_TRADING_DAYS=6,0,1,2,3


# -----------------------------------------------------------------------------
# FUNDAMENTAL & REFERENCE DATA PROVIDERS  (all optional)
# -----------------------------------------------------------------------------
# Provider chains, in preference order. A provider without its credential
# reports itself unavailable; the platform never fills the gap with an estimate.
EGX_MARKET_DATA_PROVIDERS=csv,yahoo
EGX_FUNDAMENTAL_PROVIDERS=csv,aggregator
EGX_NEWS_PROVIDERS=rss
EGX_DISCLOSURE_PROVIDERS=egx

# Credentials for those providers.
EGX_AGGREGATOR_API_KEY=
EGX_AGGREGATOR_BASE_URL=
EGX_REFINITIV_API_KEY=
EGX_BLOOMBERG_API_KEY=

# Base URLs, overridable when a provider changes an endpoint.
EGX_YAHOO_BASE_URL=https://query1.finance.yahoo.com
EGX_DISCLOSURE_BASE_URL=https://www.egx.com.eg

# Manual CSV import directory, for data delivered by file.
EGX_CSV_DATA_DIR=data/manual

# Outbound HTTP behaviour for every provider.
EGX_HTTP_TIMEOUT_SECONDS=20
EGX_HTTP_MAX_RETRIES=3
EGX_HTTP_RATE_LIMIT_PER_SECOND=4


# -----------------------------------------------------------------------------
# AI RESEARCH
# -----------------------------------------------------------------------------
# Without a key the research agents use the deterministic narrative engine.
# The system is fully functional in that mode; ratings, scores and valuations
# do not depend on the model at all.
ANTHROPIC_API_KEY=
EGX_AI_MODEL=claude-sonnet-4-5
EGX_AI_MAX_TOKENS=4096
EGX_AI_TEMPERATURE=0.2
EGX_AI_MAX_CALLS_PER_RUN=40


# -----------------------------------------------------------------------------
# SCHEDULING & NOTIFICATIONS
# -----------------------------------------------------------------------------
EGX_SCHEDULER_ENABLED=false
EGX_NOTIFICATIONS_ENABLED=false
EGX_WEEKLY_CRON=0 18 * * 4          # Thursday evening, after the EGX week ends
EGX_TIMEZONE=Africa/Cairo
EGX_NOTIFY_EMAIL_TO=
EGX_NOTIFY_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# RESEARCH & PORTFOLIO ANALYTICS
# -----------------------------------------------------------------------------
# These shape GMG's own research models and the portfolio analytics offered to
# subscribers. They do not authorise any trading: GMG never places an order.
EGX_BENCHMARK_TICKER=EGX30
EGX_PORTFOLIO_CURRENCY=EGP
EGX_PORTFOLIO_CAPITAL=1000000

# Risk limits used by the research models and backtests.
EGX_MAX_POSITION_WEIGHT=0.20
EGX_MAX_SECTOR_WEIGHT=0.30
EGX_MIN_CASH_WEIGHT=0.05
EGX_MAX_SPECULATIVE_WEIGHT=0.15
EGX_MAX_RISK_PER_POSITION=0.02
EGX_MAX_PORTFOLIO_DRAWDOWN=0.20

# Transaction-cost assumptions applied in backtests, in basis points.
EGX_COMMISSION_BPS=20
EGX_SLIPPAGE_BPS=15

# There is no broker integration and no execution path in this codebase.
# This flag exists so its absence is explicit, and nothing reads it to trade.
EGX_LIVE_TRADING_ENABLED=false


# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
# Permits generated demonstration data to be stored. Every such row is stamped
# SYNTHETIC and rendered behind a "DEMO DATA — NOT REAL-TIME" badge.
# MUST be false in production.
EGX_ALLOW_SYNTHETIC_DATA=false
