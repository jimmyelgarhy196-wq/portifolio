# =============================================================================
# EGX ALPHA — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values you have.
# The application RUNS WITHOUT ANY CREDENTIALS — every credential below is
# optional and unlocks an additional capability. Missing credentials cause the
# corresponding data to be labelled UNAVAILABLE, never fabricated.
#
#   cp .env.example .env
#
# NEVER commit your .env file. It is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE APPLICATION
# -----------------------------------------------------------------------------
EGX_ENV=development
EGX_HOST=127.0.0.1
EGX_PORT=8000
EGX_LOG_LEVEL=INFO
# Structured JSON logs (recommended for production). "text" for human reading.
EGX_LOG_FORMAT=text

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# SQLite by default (zero setup). PostgreSQL is supported by changing this URL:
#   postgresql+psycopg://user:password@localhost:5432/egx_alpha
EGX_DATABASE_URL=sqlite:///database/egx_alpha.db

# -----------------------------------------------------------------------------
# DATA PROVIDERS
# -----------------------------------------------------------------------------
# Which provider serves each data domain. Multiple providers can be listed
# comma-separated; they are tried in order and the first success wins.
#
# Market data providers:   yahoo | csv | synthetic | null
# Fundamental providers:   csv | synthetic | null
# News providers:          rss | csv | null
# Disclosure providers:    egx | csv | null
EGX_MARKET_DATA_PROVIDERS=csv,yahoo
EGX_FUNDAMENTAL_PROVIDERS=csv
EGX_NEWS_PROVIDERS=rss
EGX_DISCLOSURE_PROVIDERS=egx

# Directory scanned by the CSV providers for user-supplied real data.
# See docs/DATA_SOURCES.md for the expected file formats.
EGX_CSV_DATA_DIR=data/manual

# --- SAFETY SWITCH -----------------------------------------------------------
# The synthetic provider generates statistically plausible but ENTIRELY FICTIONAL
# prices and financials. It exists ONLY so the application can be demonstrated
# and tested offline. Every record it produces is stamped source=SYNTHETIC_DEMO
# and the UI displays a permanent red warning banner while it is enabled.
# NEVER enable this if you intend to act on the output.
EGX_ALLOW_SYNTHETIC_DATA=false

# -----------------------------------------------------------------------------
# PROVIDER CREDENTIALS (all optional)
# -----------------------------------------------------------------------------
# Yahoo Finance — no API key required. EGX tickers use the ".CA" suffix
# (e.g. COMI.CA, HRHO.CA). Coverage of EGX fundamentals is limited/absent,
# which is why fundamentals default to the CSV provider.
EGX_YAHOO_BASE_URL=https://query1.finance.yahoo.com

# Egyptian Exchange official disclosures (public, no key at time of writing).
EGX_DISCLOSURE_BASE_URL=https://www.egx.com.eg

# Optional commercial providers. Leave blank if you do not have a subscription.
# Refinitiv / LSEG
EGX_REFINITIV_API_KEY=
# Bloomberg B-PIPE
EGX_BLOOMBERG_API_KEY=
# Mubasher / Argaam / Investing.com style aggregators
EGX_AGGREGATOR_API_KEY=
EGX_AGGREGATOR_BASE_URL=

# Generic HTTP behaviour for all providers
EGX_HTTP_TIMEOUT_SECONDS=20
EGX_HTTP_MAX_RETRIES=3
EGX_HTTP_RATE_LIMIT_PER_SECOND=4

# -----------------------------------------------------------------------------
# AI RESEARCH AGENTS
# -----------------------------------------------------------------------------
# Without an API key the research agents fall back to the DETERMINISTIC
# narrative engine: it composes theses strictly from computed metrics and
# never invents anything. With a key, the LLM writes the narrative but is
# constrained to an evidence pack and must tag every statement
# FACT / CALCULATION / INFERENCE / OPINION / UNKNOWN.
ANTHROPIC_API_KEY=
EGX_AI_MODEL=claude-sonnet-5
EGX_AI_MAX_TOKENS=4000
EGX_AI_TEMPERATURE=0.2
# Hard cap on LLM calls per research run, protects against runaway cost.
EGX_AI_MAX_CALLS_PER_RUN=60

# -----------------------------------------------------------------------------
# PORTFOLIO DEFAULTS (all overridable in the Settings UI)
# -----------------------------------------------------------------------------
EGX_PORTFOLIO_CAPITAL=1000000
EGX_PORTFOLIO_CURRENCY=EGP
EGX_BENCHMARK_TICKER=EGX30
EGX_MAX_POSITION_WEIGHT=0.20
EGX_MAX_SECTOR_WEIGHT=0.30
EGX_MIN_CASH_WEIGHT=0.05
EGX_MAX_SPECULATIVE_WEIGHT=0.15
EGX_MAX_RISK_PER_POSITION=0.02
EGX_MAX_PORTFOLIO_DRAWDOWN=0.20

# Transaction cost assumptions used by paper trading and backtests.
# EGX retail commission is roughly 0.15%-0.30% all-in; tune to your broker.
EGX_COMMISSION_BPS=20
EGX_SLIPPAGE_BPS=15

# -----------------------------------------------------------------------------
# SCHEDULING / AUTOMATION
# -----------------------------------------------------------------------------
EGX_SCHEDULER_ENABLED=false
# Cron for the weekly investment committee run. Default: Friday 18:00 Cairo.
EGX_WEEKLY_CRON=0 18 * * 5
EGX_TIMEZONE=Africa/Cairo

# -----------------------------------------------------------------------------
# NOTIFICATIONS (disabled unless explicitly configured)
# -----------------------------------------------------------------------------
EGX_NOTIFICATIONS_ENABLED=false
EGX_NOTIFY_EMAIL_TO=
EGX_SMTP_HOST=
EGX_SMTP_PORT=587
EGX_SMTP_USER=
EGX_SMTP_PASSWORD=
EGX_NOTIFY_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# TRADING SAFETY — DO NOT CHANGE
# -----------------------------------------------------------------------------
# This system is PAPER TRADING / RESEARCH ONLY. There is no live broker
# integration in this codebase. This flag exists so that any future execution
# module has an explicit, auditable gate that defaults to off.
EGX_LIVE_TRADING_ENABLED=false
